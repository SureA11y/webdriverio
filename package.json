{
  "name": "@surea11y/webdriverio",
  "version": "1.4.1",
  "description": "Accessibility (a11y, WCAG) checks for WebdriverIO tests: scan the live page with new A11yCoreBuilder({ browser }).analyze() and get only proven violations, with findings that need human review listed separately.",
  "keywords": [
    "accessibility",
    "a11y",
    "a11y-testing",
    "wcag",
    "wcag21",
    "wcag22",
    "en301549",
    "en-301-549",
    "european-accessibility-act",
    "accessibility-testing",
    "webdriverio",
    "wdio",
    "webdriver",
    "e2e",
    "e2e-testing",
    "end-to-end",
    "audit",
    "aria",
    "surea11y"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/webdriverio.git"
  },
  "homepage": "https://github.com/SureA11y/webdriverio#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/webdriverio/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@surea11y/binding-base": "^1.4.0",
    "@surea11y/core": "^1.12.0"
  },
  "peerDependencies": {
    "webdriverio": ">=8.0.0"
  },
  "devDependencies": {
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "typescript": "^7.0.2",
    "webdriverio": "^9.32.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "example": "node examples/basic-scan.js",
    "example:e2e": "wdio run examples/wdio.conf.js",
    "example:pack": "node examples/scan-with-pack.js"
  }
}
