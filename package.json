  "types": "src/index.d.ts",
  "author": "Jorge Rumoroso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SureA11y/webdriverio.git"
  },
  "homepage": "https://github.com/SureA11y/webdriverio#readme",
  "bugs": {
    "url": "https://github.com/SureA11y/webdriverio/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
